<%- include('partials/header') %>
<link rel="stylesheet" href="/css/winners.css">

<main class="winners-page">
    <div class="container" style="max-width: 1000px;">
        
        <!-- Header Trang -->
        <div class="page-header">
            <h1 class="page-title">🏆 Bảng Vinh Danh</h1>
            <p class="page-subtitle">Tôn vinh các đầu bếp xuất sắc nhất qua các mùa giải Cuisine</p>
        </div>

        <!-- Thanh Lọc Winner -->
        <div class="winners-card">
            <form id="winnerFilterForm" class="winner-filter-form">
                <div class="filter-group" style="flex: 1;">
                    <select name="year" class="form-select-custom">
                        <option value="">-- Tất cả các Năm --</option>
                        <option value="2026">Năm 2026</option>
                        <option value="2025">Năm 2025</option>
                    </select>
                </div>
                <div class="filter-group" style="flex: 2;">
                    <input type="text" name="contestName" class="form-input-custom" placeholder="Tìm kiếm theo tên cuộc thi...">
                </div>
                <div class="filter-group" style="flex: 1;">
                    <button type="submit" class="btn-search">Tra Cứu</button>
                </div>
            </form>
        </div>

        <!-- Bảng hiển thị Winner -->
        <div class="winners-card" style="padding: 0; overflow: hidden;">
            <div class="table-responsive-custom">
                <table class="winners-table">
                    <thead>
                        <tr>
                            <th style="width: 18%;" class="text-center">Thứ Hạng</th>
                            <th style="width: 22%;">Thành Viên</th>
                            <th style="width: 30%;">Cuộc Thi</th>
                            <th style="width: 18%;">Giải Thưởng</th>
                            <th style="width: 12%;" class="text-center">Thời Gian</th>
                        </tr>
                    </thead>
                    <tbody id="winnersTableBody">
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                Đang tải dữ liệu người chiến thắng...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</main>

<!-- JS phụ trách load data riêng biệt -->
<script src="/js/winners.js"></script>
<%- include('partials/footer') %>