<%- include('partials/header') %>
<link rel="stylesheet" href="/css/contest-detail.css">

<main class="contest-detail-page">
    <div class="container">
        <div id="contestData" 
             data-contest-id="<%= contestId %>" 
             data-logged-in="<%= locals.user ? 'true' : 'false' %>">
        </div>

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="breadcrumb-nav">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/contests">Contests</a></li>
                <li class="breadcrumb-item active">Contest Detail</li>
            </ol>
        </nav>

        <!-- 1. Hero / Thông tin tổng quan Contest -->
        <section id="contestDetailSection" class="detail-card mb-section">
            <div class="text-center py-5">
                <p class="text-muted">Loading contest details...</p>
            </div>
        </section>

        <!-- 2. Thanh Đánh Giá & Tuơng Tác (Rating & Likes) -->
        <section class="detail-card rating-card mb-section">
            <div class="rating-wrapper">
                <div class="rating-info">
                    <h3>CONTEST RATING</h3>
                    <p class="text-muted">Calculated from user engagement and direct submissions.</p>
                </div>
                <div class="rating-actions">
                    <button id="likeBtn" class="btn btn-outline">
                        LIKE RATE: <span id="likeCount" class="font-bold">0</span>
                    </button>
                    <div id="starRate" class="score-badge">SCORE: <span id="scoreVal">0.0</span> / 5.0</div>
                </div>
            </div>
        </section>

        <!-- 3. Khu vực Hành Động (Đăng ký Offline / Form Nộp bài Online) -->
        <section id="actionArea" class="mb-section"></section>

        <!-- 4. Danh sách bài dự thi (Chỉ hiển thị với Contest Online) -->
        <section id="submissionsSection" class="mb-section d-none">
            <h2 class="section-title">SUBMITTED ENTRIES</h2>
            <div class="submissions-grid" id="submissionsList"></div>
        </section>

        <!-- 5. Khu vực Bình Luận Cộng Đồng -->
        <section class="detail-card comments-card mb-section">
            <h2 class="section-title">COMMUNITY DISCUSSION</h2>
            
            <% if (locals.user) { %>
                <form id="commentForm" class="comment-form">
                    <input type="text" id="commentInput" class="form-control" placeholder="Write a comment..." required>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>
            <% } else { %>
                <div class="notice-box mb-20">
                    Please <a href="/login" class="link-gold">Login</a> to join the conversation.
                </div>
            <% } %>

            <div id="commentList" class="comment-list"></div>
        </section>
    </div>
</main>

<script src="/js/contest-detail.js"></script>
<%- include('partials/footer') %>