<%- include('partials/header') %>

<div class="container my-4">
    <h2 class="section-title">Contest FAQ</h2>
    <p class="text-muted mb-4">Common questions about JamesThew cooking contests.</p>

    <% if (locals.user) { %>
    <div class="card p-3 my-4">
        <h5>Ask a Question</h5>
        <form id="faqForm">
            <div class="mb-3">
                <textarea id="faqQuestion" class="form-control" rows="3" placeholder="Type your question..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Submit Question</button>
        </form>
    </div>
    <% } else { %>
    <p class="text-muted"><a href="/login">Sign in</a> to ask a question.</p>
    <% } %>

    <div class="accordion my-4" id="faqAccordion">
        <p class="text-muted">Loading FAQs...</p>
    </div>
</div>

<script>
    async function loadFAQs() {
        const res = await fetch('/api/v1/faqs');
        const result = await res.json();
        const container = document.getElementById('faqAccordion');

        if (!result.success || !result.data.length) {
            container.innerHTML = '<p class="text-muted">No questions yet. Be the first to ask!</p>';
            return;
        }

        container.innerHTML = result.data.map((faq, index) => `
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading${index}">
                    <button class="accordion-button ${index !== 0 ? 'collapsed' : ''}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse${index}">
                        ${faq.question}
                    </button>
                </h2>
                <div id="collapse${index}" class="accordion-collapse collapse ${index === 0 ? 'show' : ''}" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        ${faq.answer || '<em>Pending answer from our team.</em>'}
                    </div>
                </div>
            </div>
        `).join('');
    }

    document.getElementById('faqForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const question = document.getElementById('faqQuestion').value.trim();
        if (!question) return;

        const res = await fetch('/api/v1/faqs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ question })
        });
        const result = await res.json();

        if (result.success) {
            document.getElementById('faqQuestion').value = '';
            alert('Question submitted successfully.');
            loadFAQs();
        } else {
            alert(result.message || 'Could not submit question.');
        }
    });

    loadFAQs();
</script>

<%- include('partials/footer') %>
