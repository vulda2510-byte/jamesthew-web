<%- include('partials/header') %>

<main class="profile-page-wrapper">
    <div class="container py-4">
        
        <!-- SEARCH BAR SECTION -->
        <div class="search-box-card mb-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" class="form-control border-0 shadow-none" placeholder="Search chefs or users by name or @username...">
            </div>
            <button class="btn btn-gold text-uppercase fw-bold mt-2">Search User</button>
        </div>

        <!-- USER HERO PROFILE CARD -->
        <div class="profile-hero-card mb-4">
            <div class="avatar-wrapper">
                <div class="avatar-circle">T</div>
                <button class="btn-avatar-edit" title="Change Avatar"><i class="fa-solid fa-camera"></i></button>
            </div>
            <h3 class="fw-bold mt-3 mb-1">Chef Member <span class="badge bg-secondary-subtle text-dark border ms-2">FREE MEMBER</span></h3>
            <p class="text-muted small mb-1">@tit2017vu@gmail.com</p>
            <p class="text-muted small mb-3">No bio added yet.</p>

            <div class="profile-stats d-flex justify-content-center gap-5">
                <div>
                    <span class="stat-number">0</span>
                    <span class="stat-label">RECIPES</span>
                </div>
                <div>
                    <span class="stat-number">0</span>
                    <span class="stat-label">FOLLOWERS</span>
                </div>
                <div>
                    <span class="stat-number">0</span>
                    <span class="stat-label">LIKES</span>
                </div>
            </div>
        </div>

        <!-- SUB-NAVIGATION TABS -->
        <div class="profile-nav-tabs mb-4">
            <button class="tab-btn active" onclick="switchProfileTab('overview', this)">
                <i class="fa-solid fa-user me-2"></i>Profile Overview
            </button>
            <button class="tab-btn" onclick="switchProfileTab('saved-recipes', this)">
                <i class="fa-solid fa-bookmark me-2"></i>Saved Recipes
            </button>
            <button class="tab-btn" onclick="switchProfileTab('followed-chefs', this)">
                <i class="fa-solid fa-users me-2"></i>Followed Chefs
            </button>
            <button class="tab-btn" onclick="switchProfileTab('settings', this)">
                <i class="fa-solid fa-gear me-2"></i>Account Settings
            </button>
            <button class="tab-btn" onclick="switchProfileTab('security', this)">
                <i class="fa-solid fa-lock me-2"></i>Security & Password
            </button>
        </div>

        <!-- TAB CONTENT SECTION -->
        <div class="tab-content-container">

            <!-- TAB 1: OVERVIEW -->
            <div id="tab-overview" class="tab-pane active">
                <!-- Upgrade Banner -->
                <div class="upgrade-banner-card mb-4">
                    <h5 class="fw-bold mb-1">Unlock Masterclass Recipes</h5>
                    <p class="text-muted small mb-3">Upgrade to Premium or VIP plan to access exclusive masterchef guidebooks and private culinary events.</p>
                    <button class="btn btn-gold fw-bold text-uppercase">Upgrade Plan</button>
                </div>

                <!-- Bio & Info Card -->
                <div class="info-card">
                    <h6 class="fw-bold border-bottom pb-2 mb-3">About Chef</h6>
                    <div class="mb-3">
                        <label class="text-muted small d-block">Biography</label>
                        <span>No biography provided yet.</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small d-block">Cooking Style</label>
                            <strong>Modern Gastronomy</strong>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small d-block">Location</label>
                            <strong>Not Specified</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: SAVED RECIPES -->
            <div id="tab-saved-recipes" class="tab-pane">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Saved Recipes</h5>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="card h-100 border">
                                <img src="https://images.unsplash.com/photo-1532550907401-a500c9a57435?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Recipe">
                                <div class="card-body">
                                    <h6 class="fw-bold">Pan-Seared Scallops</h6>
                                    <p class="text-muted small mb-0">By Chef Thomas Keller</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card h-100 border">
                                <img src="https://images.unsplash.com/photo-1589367920969-ab8e050bbb04?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Recipe">
                                <div class="card-body">
                                    <h6 class="fw-bold">Heritage Sourdough</h6>
                                    <p class="text-muted small mb-0">By James Thew</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 3: FOLLOWED CHEFS -->
            <div id="tab-followed-chefs" class="tab-pane">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Followed Chefs</h5>
                    <div class="d-flex align-items-center justify-content-between p-2 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar-circle-sm">A</div>
                            <div>
                                <h6 class="mb-0 fw-bold">Chef Alain Passard</h6>
                                <small class="text-muted">3-Star Michelin Chef</small>
                            </div>
                        </div>
                        <button class="btn btn-outline-secondary btn-sm">Unfollow</button>
                    </div>
                </div>
            </div>

            <!-- TAB 4: ACCOUNT SETTINGS -->
            <div id="tab-settings" class="tab-pane">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Account Settings</h5>
                    <form>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Display Name</label>
                                <input type="text" class="form-control" value="Chef Member">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Email Address</label>
                                <input type="email" class="form-control" value="tit2017vu@gmail.com" disabled>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Biography</label>
                            <textarea class="form-control" rows="3" placeholder="Tell us about your culinary journey..."></textarea>
                        </div>
                        <button type="button" class="btn btn-gold text-uppercase fw-bold">Save Changes</button>
                    </form>
                </div>
            </div>

            <!-- TAB 5: SECURITY & PASSWORD -->
            <div id="tab-security" class="tab-pane">
                <div class="info-card">
                    <h5 class="fw-bold mb-3">Security & Password</h5>
                    <form>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Current Password</label>
                            <input type="password" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">New Password</label>
                            <input type="password" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Confirm New Password</label>
                            <input type="password" class="form-control">
                        </div>
                        <button type="button" class="btn btn-gold text-uppercase fw-bold">Update Password</button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</main>

<%- include('partials/footer') %>