<link rel="stylesheet" href="/css/profile.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<%- include('partials/header') %>

<!-- FULL SCREEN PROFILE WRAPPER (LAYOUT TRÁI SANG PHẢI) -->
<div class="profile-layout-container">

    <!-- ================= SIDEBAR BÊN TRÁI ================= -->
    <aside class="profile-sidebar">
        <div class="user-profile-card">
            <div class="avatar-wrapper">
                <% if (user && user.avatarUrl) { %>
                    <img src="<%= user.avatarUrl %>" alt="Avatar" class="user-avatar-img">
                <% } else { %>
                    <div class="user-avatar-placeholder">
                        <%= (user && user.username) ? user.username.charAt(0).toUpperCase() : 'U' %>
                    </div>
                <% } %>
                <span class="role-badge role-<%= (user && user.role) ? user.role : 'free' %>">
                    <%= (user && user.role) ? user.role.toUpperCase() : 'FREE' %> MEMBER
                </span>
            </div>

            <h2 class="user-name">
                <%= (user && (user.firstName || user.lastName)) ? (user.firstName + ' ' + (user.lastName || '')).trim() : (user ? user.username : 'User') %>
            </h2>
            <p class="user-email"><%= user ? user.email : '' %></p>
            <p class="user-handle">@<%= user ? user.username : '' %></p>

            <p class="user-bio"><%= (user && user.bio) ? user.bio : 'No biography added yet.' %></p>

            <!-- Thống kê nhanh -->
            <div class="sidebar-stats">
                <div class="stat-item">
                    <span class="stat-value"><%= (stats && stats.recipesCount) || 0 %></span>
                    <span class="stat-label">Recipes</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value"><%= (stats && stats.followersCount) || 0 %></span>
                    <span class="stat-label">Followers</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value"><%= (stats && stats.likesCount) || 0 %></span>
                    <span class="stat-label">Likes</span>
                </div>
            </div>
        </div>

        <!-- SIDEBAR NAV TABS -->
        <nav class="profile-nav-sidebar">
            <button class="nav-tab-btn active" data-tab="overview">
                <i class="fa-solid fa-chart-pie"></i> Profile Overview
            </button>
            <button class="nav-tab-btn" data-tab="recipes">
                <i class="fa-solid fa-utensils"></i> Recipes & Saved
            </button>
            <button class="nav-tab-btn" data-tab="subscription">
                <i class="fa-solid fa-crown"></i> Subscription Detail
            </button>
            <button class="nav-tab-btn" data-tab="followed">
                <i class="fa-solid fa-users"></i> Followed Chefs
            </button>
            <button class="nav-tab-btn" data-tab="settings">
                <i class="fa-solid fa-user-gear"></i> Account Settings
            </button>
            <button class="nav-tab-btn" data-tab="security">
                <i class="fa-solid fa-shield-halved"></i> Security & Password
            </button>
        </nav>
    </aside>

    <!-- ================= MAIN CONTENT BÊN PHẢI ================= -->
    <main class="profile-main-content">

        <!-- Thanh tìm kiếm Chef / User -->
        <div class="top-search-section">
            <form id="searchUserForm" class="search-form">
                <div class="search-input-group">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="text" id="searchInput" placeholder="Search chefs or users by name or @username..." required>
                </div>
                <button type="submit" class="btn-gold-search">SEARCH USER</button>
            </form>
            <div id="searchResults" class="search-results-dropdown hidden"></div>
        </div>

        <!-- TAB 1: OVERVIEW -->
        <section class="tab-panel active" id="panel-overview">
            <% if (user && user.role === 'free') { %>
            <div class="upgrade-banner">
                <div class="banner-text">
                    <h3><i class="fa-solid fa-lock"></i> Unlock Masterclass Recipes</h3>
                    <p>Upgrade to Premium or VIP plan to access exclusive masterchef guidebooks and private culinary events.</p>
                </div>
                <a href="/membership" class="btn-upgrade-gold">UPGRADE PLAN</a>
            </div>
            <% } %>

            <div class="content-card">
                <h3 class="card-title"><i class="fa-solid fa-circle-info"></i> About Chef</h3>
                <div class="info-grid">
                    <div class="info-row">
                        <span class="info-label">Biography:</span>
                        <span class="info-value"><%= (user && user.bio) || 'No biography provided yet.' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Cooking Style:</span>
                        <span class="info-value text-gold"><%= (user && user.cookingStyle) || 'Not Specified' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Location:</span>
                        <span class="info-value"><%= (user && user.location) || 'Not Specified' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Website:</span>
                        <span class="info-value">
                            <% if (user && user.website) { %>
                                <a href="<%= user.website %>" target="_blank" class="link-gold"><%= user.website %></a>
                            <% } else { %>
                                Not Specified
                            <% } %>
                        </span>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 2: RECIPES -->
        <section class="tab-panel" id="panel-recipes">
            <div class="content-card">
                <div class="sub-tab-buttons">
                    <button class="sub-tab-btn active" data-sub="my-recipes">My Recipes (<%= (recipes && recipes.my) ? recipes.my.length : 0 %>)</button>
                    <button class="sub-tab-btn" data-sub="saved-recipes">Saved (<%= (recipes && recipes.saved) ? recipes.saved.length : 0 %>)</button>
                    <button class="sub-tab-btn" data-sub="favorite-recipes">Favorites (<%= (recipes && recipes.favorite) ? recipes.favorite.length : 0 %>)</button>
                </div>

                <!-- Sub Panel 1: My Recipes -->
                <div class="sub-panel active" id="sub-my-recipes">
                    <% if (!recipes || !recipes.my || recipes.my.length === 0) { %>
                        <p class="empty-state">You haven't submitted any recipes yet.</p>
                    <% } else { %>
                        <div class="recipes-grid">
                            <% recipes.my.forEach(r => { %>
                                <div class="recipe-mini-card">
                                    <h4><%= r.title %></h4>
                                    <a href="/recipes/detail/<%= r.id %>" class="btn-view">View Detail</a>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <!-- Sub Panel 2: Saved Recipes -->
                <div class="sub-panel" id="sub-saved-recipes">
                    <% if (!recipes || !recipes.saved || recipes.saved.length === 0) { %>
                        <p class="empty-state">No saved recipes found.</p>
                    <% } else { %>
                        <div class="recipes-grid">
                            <% recipes.saved.forEach(r => { %>
                                <div class="recipe-mini-card">
                                    <h4><%= r.title %></h4>
                                    <a href="/recipes/detail/<%= r.id %>" class="btn-view">View Detail</a>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <!-- Sub Panel 3: Favorite Recipes -->
                <div class="sub-panel" id="sub-favorite-recipes">
                    <% if (!recipes || !recipes.favorite || recipes.favorite.length === 0) { %>
                        <p class="empty-state">No favorite recipes yet.</p>
                    <% } else { %>
                        <div class="recipes-grid">
                            <% recipes.favorite.forEach(r => { %>
                                <div class="recipe-mini-card">
                                    <h4><%= r.title %></h4>
                                    <a href="/recipes/detail/<%= r.id %>" class="btn-view">View Detail</a>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- TAB 3: SUBSCRIPTION -->
        <section class="tab-panel" id="panel-subscription">
            <div class="content-card">
                <h3 class="card-title"><i class="fa-solid fa-id-card"></i> Membership Status</h3>
                <p>Current Plan: <strong class="text-gold"><%= (user && user.role) ? user.role.toUpperCase() : 'FREE' %></strong></p>
                <a href="/membership" class="btn-gold-search margin-top-15">Change Plan</a>
            </div>
        </section>

        <!-- TAB 4: FOLLOWED CHEFS -->
        <section class="tab-panel" id="panel-followed">
            <div class="content-card">
                <h3 class="card-title"><i class="fa-solid fa-users"></i> Chefs You Follow</h3>
                <% if (!followedChefs || followedChefs.length === 0) { %>
                    <p class="empty-state">You are not following any chefs yet.</p>
                <% } else { %>
                    <div class="chefs-list">
                        <% followedChefs.forEach(chef => { %>
                            <div class="chef-card">
                                <span>@<%= chef.username %></span>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </section>

        <!-- TAB 5: ACCOUNT SETTINGS -->
        <section class="tab-panel" id="panel-settings">
            <div class="content-card">
                <h3 class="card-title"><i class="fa-solid fa-user-pen"></i> Edit Profile Information</h3>
                <form id="updateProfileForm" class="settings-form">
                    <div class="form-row-2">
                        <div class="form-group">
                            <label>First Name</label>
                            <input type="text" name="firstName" value="<%= (user && user.firstName) || '' %>">
                        </div>
                        <div class="form-group">
                            <label>Last Name</label>
                            <input type="text" name="lastName" value="<%= (user && user.lastName) || '' %>">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Cooking Style</label>
                        <input type="text" name="cookingStyle" value="<%= (user && user.cookingStyle) || '' %>">
                    </div>
                    <div class="form-group">
                        <label>Location</label>
                        <input type="text" name="location" value="<%= (user && user.location) || '' %>">
                    </div>
                    <div class="form-group">
                        <label>Biography</label>
                        <textarea name="bio" rows="3"><%= (user && user.bio) || '' %></textarea>
                    </div>
                    <button type="submit" class="btn-gold-search">Save Changes</button>
                </form>
            </div>
        </section>

        <!-- TAB 6: SECURITY -->
        <section class="tab-panel" id="panel-security">
            <div class="content-card">
                <h3 class="card-title"><i class="fa-solid fa-lock"></i> Change Password</h3>
                <form id="changePasswordForm" class="settings-form">
                    <div class="form-group">
                        <label>Current Password</label>
                        <input type="password" name="currentPassword" required>
                    </div>
                    <div class="form-group">
                        <label>New Password</label>
                        <input type="password" name="newPassword" required>
                    </div>
                    <button type="submit" class="btn-gold-search">Update Password</button>
                </form>
            </div>
        </section>

    </main>
</div>

<%- include('partials/footer') %>

<script src="/js/profile.js"></script>