<!-- views/partials/member-sidebar.ejs -->
<aside class="member-sidebar">
    <div>
        <div class="brand-title">Chef James<br>Thew</div>
        
        <div class="user-mini-card">
            <img src="<%= user.avatarUrl || '/images/default-avatar.jpg' %>" alt="Avatar" class="user-mini-avatar">
            <div>
                <div class="user-mini-name"><%= user.firstName ? (user.firstName + ' ' + user.lastName) : user.username %></div>
                <div class="user-mini-role"><%= user.role ? user.role.toUpperCase() : 'FREE MEMBER' %></div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <a href="/profile/dashboard" class="nav-item-link <%= activeTab === 'dashboard' ? 'active' : '' %>">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                Dashboard
            </a>
            <a href="/profile/recipes" class="nav-item-link <%= activeTab === 'recipes' ? 'active' : '' %>">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
                Recipes
            </a>
            <a href="/profile/subscription" class="nav-item-link <%= activeTab === 'subscription' ? 'active' : '' %>">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                Subscription
            </a>
            <a href="/profile/settings" class="nav-item-link <%= activeTab === 'settings' ? 'active' : '' %>">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                Settings
            </a>
        </nav>
    </div>

    <div>
        <button class="btn-book-table mb-4">BOOK PRIVATE TABLE</button>
        <div class="d-flex flex-column gap-2 small text-muted">
            <a href="/support" class="text-decoration-none text-muted">Support</a>
            <a href="/logout" class="text-decoration-none text-muted">Logout</a>
        </div>
    </div>
</aside>