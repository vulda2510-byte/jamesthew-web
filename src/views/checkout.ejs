<%- include('partials/header') %>
<link rel="stylesheet" href="/css/checkout.css">

<% 
    const selectedPlan = (typeof plan !== 'undefined' && plan) ? plan : 'premium';
%>

<main class="checkout-page">
    <div class="checkout-container">
        <div class="checkout-card">
            
            <!-- Header Section -->
            <header class="checkout-header">
                <span class="checkout-badge">SECURE CHECKOUT</span>
                <h1 class="checkout-title">Complete Your Subscription</h1>
                <p class="checkout-subtitle">You are one step away from unlocking premium culinary secrets and masterclasses.</p>
            </header>
            
            <!-- Vùng hiển thị thông báo lỗi / trạng thái -->
            <div id="checkoutAlert" class="checkout-alert" style="display: none;"></div>

            <!-- Order Summary Card -->
            <div class="order-summary">
                <div class="summary-row">
                    <span class="summary-label">Selected Membership Plan</span>
                    <span id="displayPlanName" class="plan-badge plan-badge-premium">LOADING...</span>
                </div>

                <div class="summary-divider"></div>

                <div class="summary-row summary-price-row">
                    <span class="summary-label">Total Billing Amount</span>
                    <div class="price-wrapper">
                        <span id="displayPlanPrice" class="summary-price">$0.00</span>
                    </div>
                </div>

                <div class="summary-divider dashed"></div>

                <div class="summary-note">
                    <svg class="note-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <span>Subscription will be billed based on your selected plan duration. You can cancel or manage your plan anytime securely via your Profile Dashboard.</span>
                </div>
            </div>

            <!-- Payment Form / Action -->
            <form id="checkoutForm" action="/membership/create-checkout-session" method="POST" class="checkout-form">
                <input type="hidden" name="plan" id="inputPlan" value="<%= selectedPlan %>">
                <input type="hidden" name="mult" id="inputMult" value="1">
                
                <button type="button" id="btnProceedPayment" class="btn btn-checkout">
                    PROCEED TO SECURE PAYMENT
                </button>
            </form>

            <!-- Footer Link -->
            <div class="checkout-footer-link">
                <a href="/membership" class="cancel-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    CANCEL AND RETURN TO PLANS
                </a>
            </div>

        </div>
    </div>
</main>

<script src="/js/checkout.js" defer></script>

<%- include('partials/footer') %>