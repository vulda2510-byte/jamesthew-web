<link rel="stylesheet" href="/css/member-dashboard.css">
<link rel="stylesheet" href="/css/profile.css">

<%- include('../partials/header') %>

<div class="dashboard-wrapper">
    <%- include('../partials/member-sidebar', { user, activeTab, membership }) %>

    <main class="main-viewport">
        <div class="viewport-header">
            <div class="viewport-heading">
                <h1 class="page-title">Account Settings</h1>
                <p class="page-subtitle">Manage your profile, email and password.</p>
            </div>
        </div>

        <!-- Avatar -->
        <div class="content-card mb-24">
            <h3 class="card-title"><i class="fa-solid fa-camera"></i> Profile Picture</h3>
            <div class="avatar-settings-row">
                <div class="avatar-wrapper avatar-wrapper-settings">
                    <% if (user && user.avatarUrl) { %>
                        <img src="<%= user.avatarUrl %>" alt="Current avatar" class="user-avatar-img">
                    <% } else { %>
                        <div class="user-avatar-placeholder">
                            <%= (user && (user.firstName || user.username)) ? (user.firstName || user.username).charAt(0).toUpperCase() : 'U' %>
                        </div>
                    <% } %>
                </div>

                <div class="avatar-settings-actions">
                    <button type="button" id="avatarEditBtn" class="btn-gold-solid">
                        <i class="fa-solid fa-arrow-up-from-bracket"></i> Change Photo
                    </button>
                    <p class="field-hint">JPG, PNG or GIF — max 5MB.</p>
                    <p class="field-hint" id="avatarFileName" hidden></p>
                </div>

                <input type="file" id="avatarInput" accept="image/*" class="hidden">
            </div>
        </div>

        <!-- Edit Profile Information -->
        <div class="content-card mb-24">
            <h3 class="card-title"><i class="fa-solid fa-user-pen"></i> Profile Information</h3>
            <form id="updateProfileForm" class="settings-form">
                <div class="form-row-2">
                    <div class="form-group">
                        <label for="firstName">First Name</label>
                        <input type="text" id="firstName" name="firstName" value="<%= (user && user.firstName) || '' %>">
                    </div>
                    <div class="form-group">
                        <label for="lastName">Last Name</label>
                        <input type="text" id="lastName" name="lastName" value="<%= (user && user.lastName) || '' %>">
                    </div>
                </div>
                <div class="form-row-2">
                    <div class="form-group">
                        <label for="cookingStyle">Cooking Style</label>
                        <input type="text" id="cookingStyle" name="cookingStyle" value="<%= (user && user.cookingStyle) || '' %>">
                    </div>
                    <div class="form-group">
                        <label for="location">Location</label>
                        <input type="text" id="location" name="location" value="<%= (user && user.location) || '' %>">
                    </div>
                </div>
                <div class="form-row-2">
                    <div class="form-group">
                        <label for="website">Website</label>
                        <input type="text" id="website" name="website" placeholder="https://" value="<%= (user && user.website) || '' %>">
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone</label>
                        <input type="text" id="phone" name="phone" value="<%= (user && user.phone) || '' %>">
                    </div>
                </div>
                <div class="form-group">
                    <label for="bio">Biography</label>
                    <textarea id="bio" name="bio" rows="4" placeholder="Tell others about your culinary journey..."><%= (user && user.bio) || '' %></textarea>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-gold-solid">Save Changes</button>
                </div>
            </form>
        </div>

        <!-- Change Email -->
        <div class="content-card mb-24">
            <h3 class="card-title"><i class="fa-solid fa-envelope"></i> Email Address</h3>
            <form id="updateEmailForm" class="settings-form">
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required value="<%= (user && user.email) || '' %>">
                    <p class="field-hint">Used for sign-in and account notifications.</p>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-gold-solid">Update Email</button>
                </div>
            </form>
        </div>

        <!-- Change Password -->
        <div class="content-card">
            <h3 class="card-title"><i class="fa-solid fa-lock"></i> Change Password</h3>
            <form id="changePasswordForm" class="settings-form">
                <div class="form-group">
                    <label for="currentPassword">Current Password</label>
                    <input type="password" id="currentPassword" name="currentPassword" required>
                </div>
                <div class="form-row-2">
                    <div class="form-group">
                        <label for="newPassword">New Password</label>
                        <input type="password" id="newPassword" name="newPassword" minlength="8" required>
                        <p class="field-hint">At least 8 characters.</p>
                    </div>
                    <div class="form-group">
                        <label for="confirmNewPassword">Confirm New Password</label>
                        <input type="password" id="confirmNewPassword" name="confirmNewPassword" minlength="8" required>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-gold-solid">Update Password</button>
                </div>
            </form>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>

<script src="/js/profile.js"></script>
